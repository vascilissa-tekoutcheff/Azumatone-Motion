{
 "patcher": {
  "fileversion": 1,
  "classnamespace": "dsp.gen",
  "rect": [0, 0, 900, 420],
  "boxes": [
   {"box": {"id": "in1", "maxclass": "newobj", "text": "in 1", "numinlets": 0, "numoutlets": 1, "patching_rect": [30, 30, 40, 22]}},
   {"box": {"id": "code", "maxclass": "codebox", "numinlets": 1, "numoutlets": 1, "patching_rect": [30, 80, 820, 260], "code": "require(\"AzumatoneEaseFunctions.genexpr\");\n\nParam function(0, min=0, max=18);\nParam mode(0);\nParam overshoot(1);\nParam headroom(0.5);\nParam drift(0);\nData weights(19);\nHistory previous(-1);\nHistory generation(0);\nHistory initialized(0);\nHistory intensity(0);\nHistory timeWarp(0);\nHistory structural(0);\nHistory blendReady(0);\nHistory blendTarget(0);\nHistory blendRemaining(0);\nHistory characterReady(0);\nHistory characterCurrent(0);\nHistory characterTarget(0);\nHistory characterRemaining(0);\n\ndepthValue = drift;\nif (depthValue < 0) {\n    depthValue = 0;\n}\nif (depthValue > 1) {\n    depthValue = 1;\n}\nactiveValue = depthValue != 0;\nrestartValue = activeValue && azuEaseRestart(previous, in1);\nnextGeneration = restartValue ? azuEaseUint32(generation + 1) : generation;\nintensityValue = intensity;\nwarpValue = timeWarp;\nstructuralValue = structural;\nrefreshValue = activeValue && (!initialized || restartValue);\nif (refreshValue) {\n    streamValue = max(0, mc_channel() - 1);\n    seedValue = azuEaseXor32(nextGeneration, azuEaseMultiply32(streamValue, -1640531527));\n    intensityValue = azuEaseHash(seedValue);\n    warpValue = azuEaseHash(azuEaseXor32(seedValue, -1640531527));\n    structuralValue = azuEaseHash(azuEaseXor32(seedValue, -2048144777));\n}\nprevious = activeValue ? in1 : previous;\ngeneration = nextGeneration;\ninitialized = initialized || refreshValue;\nintensity = intensityValue;\ntimeWarp = warpValue;\nstructural = structuralValue;\n\ncharacterValue = characterReady ? characterCurrent : overshoot;\ncharacterSamples = characterRemaining;\nif (characterReady && overshoot != characterTarget) {\n    characterSamples = max(1, ceil(samplerate * 0.005));\n}\ncharacterNext = characterValue;\nif (characterSamples > 0) {\n    characterWeight = 1 / characterSamples;\n    characterNext = characterSamples <= 1 ? overshoot :\n        (1 - characterWeight) * characterValue + characterWeight * overshoot;\n}\ncharacterReady = 1;\ncharacterCurrent = characterNext;\ncharacterTarget = overshoot;\ncharacterRemaining = max(0, characterSamples - 1);\n\neffectiveX, effectiveAmount, effectiveStructure = azuEaseVaryInput(in1, characterValue, depthValue, intensityValue, warpValue, structuralValue);\nselectedValue = floor(max(0, min(18, function)) + 0.5);\nremainingValue = blendRemaining;\nif (blendReady && selectedValue != blendTarget) {\n    remainingValue = samplerate * 0.01;\n}\n\n// Read the current mixture before advancing it towards the new target.\nmixedValue = 0;\nblendStep = 1 / max(1, remainingValue);\nif (blendReady && remainingValue > 0) {\n    for (curveIndex = 0; curveIndex < 19; curveIndex += 1) {\n        currentWeight = peek(weights, curveIndex, 0);\n        if (currentWeight != 0) {\n            mixedValue += currentWeight * azuEaseMode(effectiveX, curveIndex, mode, effectiveAmount, effectiveStructure);\n        }\n        targetWeight = selectedValue == curveIndex;\n        nextWeight = remainingValue <= 1 ? targetWeight : currentWeight + (targetWeight - currentWeight) * blendStep;\n        poke(weights, nextWeight, curveIndex, 0);\n    }\n} else {\n    mixedValue = azuEaseMode(effectiveX, selectedValue, mode, effectiveAmount, effectiveStructure);\n    if (!blendReady) {\n        for (curveIndex = 0; curveIndex < 19; curveIndex += 1) {\n            poke(weights, selectedValue == curveIndex, curveIndex, 0);\n        }\n    }\n}\nblendRemaining = max(0, remainingValue - 1);\nblendTarget = selectedValue;\nblendReady = 1;\n\nout1 = in1 <= 0 ? 0 : (in1 >= 1 ? 1 : azuEaseLimit(mixedValue, headroom));\n"}},
   {"box": {"id": "out1", "maxclass": "newobj", "text": "out 1", "numinlets": 1, "numoutlets": 0, "patching_rect": [30, 370, 40, 22]}}
  ],
  "lines": [
   {"patchline": {"source": ["in1", 0], "destination": ["code", 0]}},
